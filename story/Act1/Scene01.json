  "dialogue": [
    {
      "speaker": "",
      "text": "Вечер медленно растворяется в холодных огнях улицы. Ты останавливаешься, заметив впереди незнакомый силуэт.",
      "background": "street1.jpg",
      "character": "Stranger.Shadow",
